  .brand-story-link { padding-left: 57px; color: #523e3d; font-size: 10px; text-decoration: underline; text-underline-offset: 2px; }
  .brand-story-link:hover { color: var(--green); }
  .brand { display: inline-flex; align-items: center; gap: 9px; flex-shrink: 0; }
  .brand-mark { width: 48px; height: 48px; display: grid; place-items: center; color: var(--green);  }
  .brand-mark img { width: 100%; height: 100%; display: block; object-fit: contain; border-radius: 50%; }
  .brand-mark svg { width: 100%; }
  .brand-mark path { stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .brand-name { font-family: var(--serif); font-size: 18px; letter-spacing: -.055em; line-height: 1; }
  .brand-name b { display: block; font-size: 15px; font-weight: 500; letter-spacing: .005em; }
  .main-nav { display: flex; align-items: center; gap: 38px; margin-left: 45px; }
  .main-nav a { color: #523e3d; font-size: 12px; transition: color .2s ease; }
  .main-nav a:hover, .text-link:hover { color: var(--orange); }
  .header-cta { padding: 12px 17px; border: 1px solid #d6a09e; border-radius: 999px; font-size: 11px; font-weight: 700; transition: background .2s, color .2s; }
  .header-cta span { margin-left: 8px; color: var(--orange); }
  .header-cta:hover { color: white; background: var(--green); }
  .basket-link { flex-shrink: 0; display: inline-flex; align-items: center; gap: 7px; padding: 10px 12px; border: 1px solid #d6a09e; border-radius: 999px; color: #523e3d; font-size: 11px; font-weight: 700; transition: background .2s, color .2s; }
  .basket-link:hover { color: #fffdf8; background: var(--green); }
  .basket-count { min-width: 17px; height: 17px; display: inline-grid; place-items: center; border-radius: 50%; color: #fffdf8; background: var(--green); font-size: 9px; line-height: 1; }

  .hero {
    position: relative;
    min-height: 490px;
    padding: 70px 0 95px;
    display: grid;
    grid-template-columns: 1fr 1.02fr;
    align-items: center;
    gap: 50px;
  }

  .homepage-logo-banner { margin-top: 36px; margin-bottom: -28px; }
  .homepage-logo-banner img { display: block; width: 100%; height: auto; object-fit: contain; }
  .hero-brand-logo { display: none; }
  .hero-copy { position: relative; z-index: 1; max-width: 490px; padding-bottom: 5px; }
  .eyebrow { color: #758174; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .eyebrow-star { margin-right: 7px; color: var(--orange); font-size: 14px; vertical-align: -1px; }
  h1, h2, h3, p { margin-top: 0; }
  .hero h1 { margin: 21px 0 16px; font-family: var(--serif); font-size: clamp(44px, 4.4vw, 60px); font-weight: 500; letter-spacing: -.065em; line-height: .99; }
  h1 em, h2 em { color: #82927a; font-weight: 500; }
  .hero-copy > p { max-width: 390px; margin-bottom: 25px; color: #6b746c; font-size: 14px; line-height: 1.8; }
  .button { min-height: 46px; display: inline-flex; align-items: center; justify-content: center; gap: 24px; padding: 0 19px; border-radius: 4px; font-size: 11px; font-weight: 700; transition: transform .2s, background .2s; }
  .button:hover { transform: translateY(-2px); }
  .button-dark { color: #fffdf8; background: var(--green); }
  .button-dark:hover { background: var(--green-deep); }
  .button span { font-size: 16px; font-weight: 400; }
  .hero-note { display: flex; align-items: center; gap: 11px; margin-top: 29px; color: #81877d; font-size: 10px; }
  .hero-note b { color: var(--green); font-weight: 700; }
  .avatar-stack { display: flex; padding-left: 2px; }
  .avatar-stack span { width: 26px; height: 26px; display: grid; place-items: center; margin-left: -4px; border: 2px solid var(--cream); border-radius: 50%; background: #e6d5bd; font-size: 12px; }
  .avatar-stack span:nth-child(2) { background: #d7e3d2; }
  .avatar-stack span:nth-child(3) { background: #f0d7c4; }

  .hero-art { position: relative; min-height: 345px; display: grid; place-items: center; }
  .hero-photo { position: relative; width: min(100%, 465px); height: 335px; overflow: hidden; border-radius: 48% 48% 8px 8px; background: #e3d7c2; }
  .hero-photo::after { position: absolute; inset: 0; content: ''; background: linear-gradient(180deg, transparent 62%, rgba(32, 45, 37, .1)); }
  .hero-photo img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center 54%; }
  .sun-doodle { position: absolute; top: 10px; right: 3%; color: #d49b56; font-size: 44px; }
  .hero-sticker { position: absolute; bottom: 24px; left: 1%; z-index: 1; width: 118px; height: 118px; display: flex; flex-direction: column; align-items: center; justify-content: center; transform: rotate(-10deg); border: 1px solid #ead9ac; border-radius: 50%; background: #f3e7c7; color: var(--green); text-align: center; font-family: var(--serif); font-size: 15px; line-height: 1.15; box-shadow: 0 7px 22px #263d3212; }
  .sticker-sparkle { position: absolute; top: 12px; color: #d29651; font-size: 15px; }
  .sticker-heart { margin-top: 5px; color: #c9775a; font-family: var(--sans); font-size: 11px; }
