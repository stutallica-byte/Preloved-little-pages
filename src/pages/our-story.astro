.how-section{background:#fffdf8}.how-inner{width:100%;margin:0}.how-intro h2 br,.quality-copy h2 br{display:none}.how-intro h2 em:before,.quality-copy h2 em:before{content:' '}.steps{display:grid;gap:7px;margin-top:10px}.step{display:grid;grid-template-columns:25px 1fr;column-gap:8px;align-items:center;border-top:1px solid #e7dcd3;padding-top:7px}.step-number{grid-column:1;grid-row:1;font-size:10px;color:#687b67}.step-illustration{grid-column:1;grid-row:2;font:500 24px/1 var(--serif);color:#a65e55}.step h3{grid-column:2;grid-row:1;font:500 15px/1.2 var(--serif)}.step p{grid-column:2;grid-row:2;font-size:13px}.quality-section{background:#edf0e6;display:flex;flex-direction:column;justify-content:center;gap:8px}.quality-art{order:2;display:flex;justify-content:center}.quality-book.book-back{display:none}.quality-book.book-front{font:500 15px/1.1 var(--serif);color:#526b55;transform:rotate(-4deg);border:1px solid #b8c1ae;border-radius:4px;padding:6px 12px;text-align:center;background:#f8f6ef}.quality-book br{display:none}.quality-book i{font-style:normal;color:#a65e55;margin-left:5px}.quality-points{display:flex;flex-wrap:wrap;gap:4px 12px;list-style:none;padding:0;margin:9px 0 0;font-size:12px;color:#355747}.quality-points li span{color:#a65e55;font-weight:bold}
