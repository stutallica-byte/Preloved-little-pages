---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f6ef" />
    <meta
      name="description"
      content="Find your next favourite story at Preloved Little Pages: a cosy corner for pre-loved children's books and new little readers."
    />
    <link rel="icon" type="image/webp" href="/preloved-little-pages-logo.webp" />
    <title>Preloved Little Pages — Stories worth sharing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-brand-group">
        <a class="brand" href="#our-story" aria-label="Preloved Little Pages — find out why">
          <span class="brand-mark" aria-hidden="true"><img src="/preloved-little-pages-logo.webp" alt="" width="56" height="56" decoding="async" /></span>
          <span class="brand-name">Preloved <b>Little Pages</b></span>
        </a>
        <a class="brand-story-link" href="#our-story">Find out why <span aria-hidden="true">→</span></a>
      </div>

      <nav class="main-nav" aria-label="Main navigation">
        <a href="/books/">Shop books</a>
        <a href="#how-it-works">How it works</a>
        <a href="#our-story">Our story</a>
      </nav>

      <a class="basket-link" data-basket-link href="/basket/" aria-label="Basket, 0 books">
        Basket <span class="basket-count" data-basket-count>0</span>
      </a>
    </header>

    <main id="top">
      <div class="page-width homepage-logo-banner">
        <img src="/preloved-homepage-wide-logo.webp" alt="Preloved Little Pages — illustrated books and lettering" width="1800" height="600" decoding="async" fetchpriority="high" />
      </div>
      <section class="hero page-width" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-star">✳</span> Welcome to a little world of stories</div>
          <h1 id="hero-title">Little books.<br />Big <em>adventures.</em></h1>
          <p>
            The next chapter starts here. Find gently read children's books ready
            to be loved all over again.
          </p>
          <a class="button button-dark" href="#books">
            Browse the books <span aria-hidden="true">→</span>
          </a>
          <div class="hero-note">
            <div class="avatar-stack" aria-hidden="true">
              <span>🌼</span><span>📚</span><span>🧸</span>
            </div>
            <span>Good stories are even better <b>when shared.</b></span>
          </div>
        </div>

        <div class="hero-art" aria-label="A cosy stack of pre-loved storybooks">
          <div class="sun-doodle" aria-hidden="true">✳</div>
          <div class="hero-photo">
            <img
              src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=1200&q=85"
              alt="A well-loved open book waiting to be read"
              fetchpriority="high"
            />
          </div>
          <div class="hero-sticker">
            <span class="sticker-sparkle" aria-hidden="true">✳</span>
            <span>Passed on<br />with love</span>
            <span class="sticker-heart" aria-hidden="true">♥</span>
          </div>
          <div class="hero-caption"><span></span> Your next bedtime favourite is in here</div>
        </div>

        <form class="search-bar" id="book-search" role="search">
          <span class="search-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="10.8" cy="10.8" r="6.8"></circle>
              <path d="m16 16 4.5 4.5"></path>
            </svg>
          </span>
          <label class="sr-only" for="search-input">Search books by title or theme</label>
          <input id="search-input" type="search" placeholder="What kind of story are you looking for?" />
          <button type="submit">Find a book <span aria-hidden="true">→</span></button>
        </form>
      </section>

      <section class="trust-strip" aria-label="Why shop with us">
        <div><span aria-hidden="true">↗</span> Lovely books, little prices</div>
        <i aria-hidden="true"></i>
        <div><span aria-hidden="true">♡</span> Every book deserves another reader</div>
        <i aria-hidden="true"></i>
        <div><span aria-hidden="true">✳</span> Kinder on little feet and the planet</div>
      </section>

      <section class="books-section page-width" id="books" aria-labelledby="books-title">
        <div class="section-heading">
          <div>
            <div class="eyebrow"><span class="eyebrow-star">✳</span> Picked with love</div>
            <h2 id="books-title">A shelf full of <em>possibilities</em></h2>
          </div>
          <a class="text-link" href="#book-search">Search all stories <span aria-hidden="true">↗</span></a>
        </div>

        <div class="category-pills" aria-label="Popular book themes">
          <a class="category-pill active" href="#books">All the good stuff <span>✳</span></a>
          <a class="category-pill" href="#book-search" data-query="bedtime">Bedtime tales <span>☾</span></a>
          <a class="category-pill" href="#book-search" data-query="adventure">Big adventures <span>↗</span></a>
          <a class="category-pill" href="#book-search" data-query="feelings">Little feelings <span>♡</span></a>
          <a class="category-pill" href="#book-search" data-query="nature">Nature & wonder <span>✿</span></a>
        </div>

        <div class="book-grid" id="book-grid">
          {books.map((book) => (
            <article class="book-card" data-search={book.search}>
              <a class="book-cover-wrap" href="#how-it-works" aria-label={`Learn about ${book.title}`}>
                <div class={`book-cover ${book.color}`}>
                  <span class="cover-kicker">A LITTLE STORY</span>
                  <div class={`cover-art ${book.art}`} aria-hidden="true">
                    {book.art === 'garden' && <><span class="garden-sun">☼</span><span class="garden-flower">✿</span><span class="garden-leaf">✳</span></>}
                    {book.art === 'moon' && <><span class="moon-shape"></span><span class="moon-star star-one">✦</span><span class="moon-star star-two">✧</span><span class="moon-star star-three">·</span></>}
                    {book.art === 'fox' && <><span class="fox-tail"></span><span class="fox-face"><i></i><b></b></span><span class="fox-star">✦</span></>}
                    {book.art === 'cloud' && <><span class="cloud-shape"></span><span class="cloud-rain rain-one"></span><span class="cloud-rain rain-two"></span><span class="cloud-rain rain-three"></span></>}
                  </div>
                  <span class="cover-title">{book.title}</span>
                  <span class="cover-author">a story to share</span>
                  <span class="cover-spine" aria-hidden="true"></span>
                </div>
                <span class="condition-tag">{book.condition}</span>
                <span class="save-book" aria-hidden="true">♡</span>
              </a>
              <div class="book-info">
                <div>
                  <h3>{book.title}</h3>
                  <p>{book.author}</p>
                </div>
                <span class="book-price">{book.price}</span>
              </div>
            </article>
          ))}
        </div>
        <p class="empty-state" id="empty-state" hidden>No books found just yet. Try another word or theme.</p>
        <div class="center-action"><a class="button button-outline" href="#book-search">Explore the shelves <span aria-hidden="true">→</span></a></div>
      </section>

      <section class="how-section" id="how-it-works" aria-labelledby="how-title">
        <div class="page-width how-inner">
          <div class="how-intro">
            <div class="eyebrow"><span class="eyebrow-star">✳</span> The lovely little loop</div>
            <h2 id="how-title">Read it. Love it.<br /><em>Pass it on.</em></h2>
            <p>Every story gets to go on and on. Here's how we make a little magic happen.</p>
            <a class="text-link" href="#our-story">More about our mission <span aria-hidden="true">↗</span></a>
          </div>
          <div class="steps">
            <article class="step">
              <span class="step-number">01</span>
              <span class="step-illustration step-search" aria-hidden="true">⌕</span>
              <h3>Find their next favourite</h3>
              <p>Browse a hand-picked shelf of stories for every little kind of reader.</p>
            </article>
            <article class="step">
              <span class="step-number">02</span>
              <span class="step-illustration step-book" aria-hidden="true">▤</span>
              <h3>Make story time yours</h3>
              <p>Your book arrives ready for cuddles, giggles and one-more-page pleas.</p>
            </article>
            <article class="step">
              <span class="step-number">03</span>
              <span class="step-illustration step-heart" aria-hidden="true">♡</span>
              <h3>Let the story travel</h3>
              <p>When you're ready, pass it on and help another little reader begin.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="quality-section page-width" aria-labelledby="quality-title">
        <div class="quality-art" aria-hidden="true">
          <span class="quality-sparkle sparkle-left">✳</span>
          <span class="quality-book book-back"></span>
          <span class="quality-book book-front"><span>good<br />stories<br /><em>go on</em></span><i>♥</i></span>
          <span class="quality-sparkle sparkle-right">✦</span>
        </div>
        <div class="quality-copy">
          <div class="eyebrow"><span class="eyebrow-star">✳</span> Lovely books, ready for another little reader</div>
          <h2 id="quality-title">Quality stories.<br /><em>Preloved with care.</em></h2>
          <p>
            We sell quality preloved children's books, chosen for their lovely
            stories and checked with care before they make their way to you.
            Each one is ready for new adventures, favourite voices and one
            more bedtime chapter.
          </p>
          <ul class="quality-points">
            <li><span aria-hidden="true">✓</span> Checked page by page</li>
            <li><span aria-hidden="true">✓</span> Clearly described condition</li>
            <li><span aria-hidden="true">✓</span> Ready to be loved again</li>
          </ul>
          <a class="text-link" href="#books">Shop quality preloved books <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="story-section page-width" id="our-story" aria-labelledby="story-title">
        <div class="story-card">
          <div class="story-scribble" aria-hidden="true">stories<br />are for<br /><em>sharing</em><span>✳</span></div>
          <div class="story-copy">
            <div class="eyebrow"><span class="eyebrow-star">✳</span> A small idea with a big heart</div>
            <h2 id="story-title">Because the best stories are <em>never one-and-done.</em></h2>
            <p>
              We believe a well-loved book still has plenty of wonder left in its
              pages. So we're making it easier for stories to find new homes —
              and for little readers to find the stories that stay with them.
            </p>
            <a class="button button-dark" href="#books">Find your story <span aria-hidden="true">→</span></a>
          </div>
          <span class="story-flower flower-a" aria-hidden="true">✿</span>
          <span class="story-flower flower-b" aria-hidden="true">✳</span>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-width footer-inner">
        <a class="brand footer-brand" href="#top">
          <span class="brand-mark" aria-hidden="true"><img src="/preloved-little-pages-logo.webp" alt="" width="56" height="56" decoding="async" /></span>
          <span class="brand-name">Preloved <b>Little Pages</b></span>
        </a>
        <p>Small pages. Big-hearted stories. <span aria-hidden="true">♥</span></p>
        <a class="back-top" href="#top">Back to the top ↑</a>
      </div>
      <div class="footer-bottom page-width">
        <span>© 2026 Preloved Little Pages</span>
        <span>@preloved little pages</span>
        <span>Made for little readers, with a little more love.</span>
      </div>
    </footer>
  </body>
</html>

<script>
  import { getBasketIds, onBasketChange } from '../lib/basket';

  const searchForm = document.querySelector<HTMLFormElement>('#book-search');
  const searchInput = document.querySelector<HTMLInputElement>('#search-input');
  const bookCards = [...document.querySelectorAll<HTMLElement>('.book-card')];
  const emptyState = document.querySelector<HTMLElement>('#empty-state');
  const categoryLinks = document.querySelectorAll<HTMLAnchorElement>('.category-pill[data-query]');
  const basketLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-basket-link]')];

  function updateBasketCount() {
    try {
      const count = getBasketIds().length;
      for (const link of basketLinks) {
        const badge = link.querySelector<HTMLElement>('[data-basket-count]');
        if (badge) badge.textContent = String(count);
        link.setAttribute('aria-label', `Basket, ${count} ${count === 1 ? 'book' : 'books'}`);
      }
    } catch (error) {
      console.error('Unable to read the saved basket:', error);
    }
  }

  updateBasketCount();
  onBasketChange(updateBasketCount);

  function filterBooks(query: string) {
    const normalizedQuery = query.trim().toLowerCase();
    let visibleBooks = 0;

    for (const card of bookCards) {
      const matches = !normalizedQuery || card.dataset.search?.includes(normalizedQuery) || card.textContent?.toLowerCase().includes(normalizedQuery);
      card.hidden = !matches;
      if (matches) visibleBooks += 1;
    }

    if (emptyState) emptyState.hidden = visibleBooks > 0;
  }

  searchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    filterBooks(searchInput?.value ?? '');
    document.querySelector('#books')?.scrollIntoView({ behavior: 'smooth' });
  });

  searchInput?.addEventListener('input', () => filterBooks(searchInput.value));

  for (const link of categoryLinks) {
    link.addEventListener('click', () => {
      const query = link.dataset.query ?? '';
      if (searchInput) searchInput.value = query;
      filterBooks(query);
    });
  }
</script>

<style>
  :root {
    --ink: #263d32;
    --green: #355747;
    --green-deep: #264536;
    --sage: #dce8d9;
    --cream: #f8f6ef;
    --paper: #fffdf8;
    --muted: #72796f;
    --line: #e7e4da;
    --orange: #e48c58;
    --serif: 'Fraunces', Georgia, serif;
    --sans: 'DM Sans', Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--cream);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }
  button, input { font: inherit; }
  .page-width { width: min(1160px, calc(100% - 64px)); margin-inline: auto; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .site-header {
    height: 82px;
    width: 100%;
    padding-inline: max(32px, calc((100% - 1260px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: #efb4b1;
  }

