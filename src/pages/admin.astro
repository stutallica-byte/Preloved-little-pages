<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f8f6ef" />
    <link rel="icon" type="image/webp" href="/preloved-little-pages-logo.webp" />
    <title>Admin — Preloved Little Pages</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Preloved Little Pages home">
        <span class="brand-mark" aria-hidden="true"><img src="/preloved-little-pages-logo.webp" alt="" width="56" height="56" decoding="async" /></span>
        <span class="brand-name">Preloved <b>Little Pages</b></span>
      </a>
      <a class="back-link" href="/books/">Back to the bookshop <span aria-hidden="true">↗</span></a>
    </header>

    <main class="page-width">
      <section class="page-heading">
        <span class="eyebrow"><span aria-hidden="true">✳</span> The little bookshop, behind the scenes</span>
        <h1>Book <em>management</em></h1>
        <p>Sign in with an authorised admin account to manage your books.</p>
      </section>

      <p class="notice" id="auth-notice" role="status" aria-live="polite" hidden></p>

      <section class="panel login-panel" id="login-panel" aria-labelledby="login-title">
        <div class="panel-heading">
          <div class="eyebrow">Admin access</div>
          <h2 id="login-title">Welcome back</h2>
          <p>Use your administrator email and password to continue.</p>
        </div>
        <form id="login-form" novalidate>
          <label for="admin-email">Email address</label>
          <input id="admin-email" name="email" type="email" autocomplete="username" required />
          <label for="admin-password">Password</label>
          <input id="admin-password" name="password" type="password" autocomplete="current-password" required />
          <button class="primary-button" type="submit">Sign in <span aria-hidden="true">→</span></button>
        </form>
      </section>

      <section class="dashboard" id="dashboard-panel" aria-labelledby="dashboard-title" hidden>
        <div class="dashboard-heading">
          <div>
            <div class="eyebrow">Your shelves</div>
            <h2 id="dashboard-title">Your bookshop</h2>
          </div>
          <button class="quiet-button" id="sign-out" type="button">Sign out <span aria-hidden="true">↗</span></button>
        </div>

        <p class="notice" id="dashboard-notice" role="status" aria-live="polite" hidden></p>

        <div class="admin-tabs" role="tablist" aria-label="Book management">
          <button type="button" role="tab" id="add-books-tab" aria-controls="add-books-panel" aria-selected="true" tabindex="0">＋ Add Books</button>
          <button type="button" role="tab" id="manage-books-tab" aria-controls="manage-books-panel" aria-selected="false" tabindex="-1">Manage Books</button>
        </div>
        <div class="admin-layout">
          <section class="panel editor-panel" id="add-books-panel" role="tabpanel" aria-labelledby="add-books-tab">
            <div class="panel-heading">
              <div class="eyebrow">Book details</div>
              <h2 id="editor-title">Add a book</h2>
            </div>
            <form id="book-form">
              <input id="book-id" name="id" type="hidden" />
              <div class="photo-picker">
                <label for="book-cover" class="photo-label">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h4l2-3h4l2 3h4a2 2 0 0 1 2 2v11H2V8a2 2 0 0 1 2-2Z"/><circle cx="12" cy="12" r="4"/></svg>
                  <strong>Take photo or choose from library</strong>
                  <span>Book cover · automatically resized and compressed · up to 30 MB before processing</span>
                  <img id="cover-preview" alt="Selected book cover" hidden />
                </label>
                <input id="book-cover" name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/heic,image/heif,.heic,.heif" />
                <button class="quiet-button" type="button" id="clear-cover" hidden>Remove selected photo</button>
                <p class="current-cover" id="current-cover" hidden></p>
              </div>
              <label for="book-title">Book title</label>
              <input id="book-title" name="title" type="text" maxlength="200" placeholder="Enter book title" required />

              <label for="book-author">Author</label>
              <input id="book-author" name="author" type="text" maxlength="200" placeholder="Enter author" required />

              <div class="form-row">
                <div>
                  <label for="book-price">Price (£)</label>
                  <input id="book-price" name="price" type="number" min="0" step="0.01" required />
                  <div class="quick-options" role="group" aria-label="Quick price selection">
                    {['1','2','3','4'].map((price) => <button type="button" data-quick-price={price} aria-pressed="false">£{price}</button>)}
                    <button type="button" data-quick-price="other">Other</button>
                  </div>
                </div>
                <div>
                  <label for="book-condition">Condition</label>
                  <select id="book-condition" name="condition" required>
                    <option value="">Choose condition</option>
                    <option value="Excellent">Excellent</option>
                    <option value="Very good">Very good</option>
                    <option value="Good">Good</option>
                  </select>
                  <div class="quick-options" role="group" aria-label="Quick condition selection">
                    {['Excellent','Very good','Good'].map((condition) => <button type="button" data-quick-condition={condition} aria-pressed="false">{condition}</button>)}
                  </div>
                </div>
              </div>



              <details class="optional-details" id="optional-details">
                <summary>Additional details (optional)</summary>
                <label for="book-description">Description</label>
                <textarea id="book-description" name="description" rows="3" maxlength="2000" placeholder="Any additional details"></textarea>
              </details>
              <label class="checkbox-row" for="book-sold">
                <input id="book-sold" name="sold" type="checkbox" />
                <span>Mark this book as sold</span>
              </label>

              <div class="form-actions">
                <button class="primary-button" id="save-book" type="submit">Add book <span aria-hidden="true">→</span></button>
                <button class="quiet-button" id="save-another" type="submit">Save and add another</button>
                <button class="quiet-button" id="cancel-edit" type="button" hidden>Cancel edit</button>
              </div>
            </form>
          </section>

          <section class="panel inventory-panel" id="manage-books-panel" role="tabpanel" aria-labelledby="manage-books-tab" hidden>
            <div class="inventory-heading">
              <div>
                <div class="eyebrow">Supabase · public.books</div>
                <h2 id="inventory-title">Your inventory</h2>
              </div>
              <button class="quiet-button" id="refresh-books" type="button">Refresh <span aria-hidden="true">↻</span></button>
            </div>
            <div class="inventory-state" id="inventory-state" role="status" aria-live="polite">Loading your books...</div>
            <div class="inventory-list" id="inventory-list" aria-busy="true"></div>
          </section>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-width footer-inner">
        <span>© 2026 Preloved Little Pages</span>
        <span>Admin access is protected by Supabase Auth and database policies.</span>
      </div>
    </footer>
  </body>
</html>

<script>
  import { getSupabaseClient } from '../lib/supabase';

  type BookRow = Record<string, unknown> & { id: string | number };

  const loginPanel = document.querySelector<HTMLElement>('#login-panel');
  const dashboardPanel = document.querySelector<HTMLElement>('#dashboard-panel');
  const loginForm = document.querySelector<HTMLFormElement>('#login-form');
  const loginEmail = document.querySelector<HTMLInputElement>('#admin-email');
  const loginPassword = document.querySelector<HTMLInputElement>('#admin-password');
  const authNotice = document.querySelector<HTMLParagraphElement>('#auth-notice');
  const dashboardNotice = document.querySelector<HTMLParagraphElement>('#dashboard-notice');
  const inventoryList = document.querySelector<HTMLDivElement>('#inventory-list');
  const inventoryState = document.querySelector<HTMLDivElement>('#inventory-state');
  const bookForm = document.querySelector<HTMLFormElement>('#book-form');
  const bookId = document.querySelector<HTMLInputElement>('#book-id');
  const bookTitle = document.querySelector<HTMLInputElement>('#book-title');
  const bookAuthor = document.querySelector<HTMLInputElement>('#book-author');
  const bookDescription = document.querySelector<HTMLTextAreaElement>('#book-description');
  const bookPrice = document.querySelector<HTMLInputElement>('#book-price');
  const bookCondition = document.querySelector<HTMLSelectElement>('#book-condition');
  const bookCover = document.querySelector<HTMLInputElement>('#book-cover');
  const coverPreview = document.querySelector<HTMLImageElement>("#cover-preview");
  const clearCover = document.querySelector<HTMLButtonElement>("#clear-cover");
  const optionalDetails = document.querySelector<HTMLDetailsElement>("#optional-details");
  let previewUrl: string | undefined;
  function showSelectedCover() {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = undefined;
    const file = bookCover?.files?.[0];
    if (file && coverPreview) {
      previewUrl = URL.createObjectURL(file);
      coverPreview.src = previewUrl;
      coverPreview.hidden = false;
    } else if (coverPreview) {
      coverPreview.removeAttribute("src");
      coverPreview.hidden = true;
    }
    if (clearCover) clearCover.hidden = !file;
  }
  bookCover?.addEventListener("change", showSelectedCover);
  clearCover?.addEventListener("click", () => { if (bookCover) bookCover.value = ""; showSelectedCover(); });
  const currentCover = document.querySelector<HTMLParagraphElement>('#current-cover');
  const bookSold = document.querySelector<HTMLInputElement>('#book-sold');
  const saveButton = document.querySelector<HTMLButtonElement>('#save-book');
  const saveAnotherButton = document.querySelector<HTMLButtonElement>('#save-another');
  let savingBook = false;
  const cancelEditButton = document.querySelector<HTMLButtonElement>('#cancel-edit');
  const refreshButton = document.querySelector<HTMLButtonElement>('#refresh-books');
  const signOutButton = document.querySelector<HTMLButtonElement>('#sign-out');

  let supabase: ReturnType<typeof getSupabaseClient> | undefined;

  function getString(row: Record<string, unknown>, keys: string[]): string | undefined {
    for (const key of keys) {
      const value = row[key];
      if (typeof value === 'string' && value.trim()) return value.trim();
    }

    return undefined;
  }

  function formatPrice(value: unknown): string {
    if (typeof value === 'number' && Number.isFinite(value)) return `£${value.toFixed(2)}`;
    if (typeof value === 'string' && value.trim()) {
      const price = value.trim();
      return /^\d+(?:\.\d{1,2})?$/.test(price) ? `£${Number(price).toFixed(2)}` : price;
    }

    return 'Price unavailable';
  }

  function getImageUrl(row: Record<string, unknown>): string | undefined {
    const value = getString(row, ['image_url']);
    if (!value) return undefined;

    try {
      const url = new URL(value, window.location.origin);
      return url.protocol === 'https:' || url.protocol === 'http:' ? url.href : undefined;
    } catch {
      return undefined;
    }
  }

  function getBucketPath(value: string | undefined): string | undefined {
    if (!value) return undefined;

    try {
      const pathname = new URL(value).pathname;
      const marker = '/storage/v1/object/public/books-images/';
      const markerIndex = pathname.indexOf(marker);
      return markerIndex < 0 ? undefined : decodeURIComponent(pathname.slice(markerIndex + marker.length));
    } catch {
      return undefined;
    }
  }

  function setNotice(element: HTMLParagraphElement | null, message: string, kind: 'info' | 'success' | 'error' = 'info') {
    if (!element) return;
    element.textContent = message;
    element.dataset.kind = kind;
    element.hidden = false;
  }

  function clearNotice(element: HTMLParagraphElement | null) {
    if (!element) return;
    element.textContent = '';
    element.hidden = true;
  }

  const adminTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.admin-tabs [role="tab"]'));

  function selectAdminTab(id: string, focus = false) {
    for (const tab of adminTabs) {
      const selected = tab.id === id;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !selected;
      if (selected && focus) tab.focus();
    }
  }

  for (const tab of adminTabs) {
    tab.addEventListener('click', () => selectAdminTab(tab.id));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const index = adminTabs.indexOf(tab);
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? adminTabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + adminTabs.length) % adminTabs.length;
      selectAdminTab(adminTabs[next].id, true);
    });
  }

  function showLogin() {
    if (loginPanel) loginPanel.hidden = false;
    if (dashboardPanel) dashboardPanel.hidden = true;
  }

  function showDashboard() {
    if (loginPanel) loginPanel.hidden = true;
    if (dashboardPanel) dashboardPanel.hidden = false;
    clearNotice(authNotice);
  }

  async function clearLocalSession() {
    if (!supabase) return;

    try {
      const { error } = await supabase.auth.signOut({ scope: 'local' });
      if (error) console.error('Unable to clear the unverified local admin session:', error);
    } catch (error) {
      console.error('Unable to clear the unverified local admin session:', error);
    }
  }

  function getAuthErrorMessage(error: unknown): string {
    const message = error instanceof Error ? error.message : '';
    const normalizedMessage = message.toLowerCase();

    if (normalizedMessage.includes('invalid login credentials')) {
      return 'Email or password is incorrect.';
    }
    if (normalizedMessage.includes('email not confirmed')) {
      return 'Please confirm your email address before signing in.';
    }
    if (normalizedMessage.includes('rate limit') || normalizedMessage.includes('too many requests')) {
      return 'Too many sign-in attempts. Please wait a moment and try again.';
    }
    if (normalizedMessage.includes('timed out') || normalizedMessage.includes('timeout')) {
      return 'Supabase Authentication timed out. Check your connection and project URL, then try again.';
    }
    if (normalizedMessage.includes('failed to fetch') || normalizedMessage.includes('network')) {
      return 'Could not reach Supabase Authentication. Check your connection and project URL.';
    }

    return message ? `Sign-in failed: ${message}` : 'Sign-in failed unexpectedly. Please try again.';
  }

  function getErrorCode(error: unknown): string | undefined {
    if (typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string') {
      return error.code;
    }

    return undefined;
  }

  async function authorizeCurrentUser(): Promise<boolean> {
    if (!supabase) return false;

    setNotice(authNotice, 'Signed in. Checking administrator access...');

    try {
      const { data, error } = await supabase.rpc('is_admin');
      if (error) {
        console.error('Unable to verify admin access:', error);
        await clearLocalSession();
        showLogin();
        const message = getErrorCode(error) === 'PGRST202'
          ? 'Sign-in succeeded, but admin authorization is not set up yet. Apply the admin security migration and add this account to public.admin_users.'
          : 'Sign-in succeeded, but administrator access could not be verified. Check your connection and the Supabase admin setup. The dashboard remains locked.';
        setNotice(authNotice, message, 'error');
        return false;
      }

      if (data !== true) {
        await clearLocalSession();
        showLogin();
        setNotice(authNotice, 'You are signed in, but this account is not authorized to manage books.', 'error');
        return false;
      }

      showDashboard();
      await loadBooks();
      return true;
    } catch (error) {
      console.error('Admin authorization check failed:', error);
      await clearLocalSession();
      showLogin();
      setNotice(authNotice, 'Sign-in succeeded, but administrator access could not be verified. Check your connection and try again. The dashboard remains locked.', 'error');
      return false;
    }
  }

  async function loadBooks() {
    if (!supabase || !inventoryList || !inventoryState) return;

    inventoryList.replaceChildren();
    inventoryList.setAttribute('aria-busy', 'true');
    inventoryState.hidden = false;
    inventoryState.textContent = 'Loading your books...';

    try {
      const { data, error } = await supabase
        .from('books')
        .select('id,created_at,title,author,price,condition,description,image_url,sold')
        .order('title', { ascending: true });
      if (error) throw error;
      if (!Array.isArray(data)) throw new Error('Supabase returned an invalid books response.');

      const rows = data.filter(
        (row): row is BookRow =>
          typeof row === 'object' &&
          row !== null &&
          !Array.isArray(row) &&
          (typeof row.id === 'string' || typeof row.id === 'number'),
      );

      if (rows.length === 0) {
        inventoryState.textContent = 'No books yet. Add the first one using the form.';
        return;
      }

      inventoryState.hidden = true;
      inventoryList.append(...rows.map(renderBookRow));
    } catch (error) {
      console.error('Unable to load admin book inventory:', error);
      inventoryState.textContent = 'Could not load your books. Check the database setup and try again.';
    } finally {
      inventoryList.setAttribute('aria-busy', 'false');
    }
  }

  function renderBookRow(book: BookRow): HTMLElement {
    const title = getString(book, ['title', 'name']) ?? 'Untitled book';
    const author = getString(book, ['author', 'authors']) ?? 'Author not listed';
    const condition = getString(book, ['condition']) ?? 'Condition not listed';
    const sold = book.sold === true;

    const row = document.createElement('article');
    row.className = 'inventory-item';
    row.dataset.bookId = String(book.id);
    row.dataset.coverUrl = getImageUrl(book) ?? '';

    const coverUrl = getImageUrl(book);
    if (coverUrl) {
      const image = document.createElement('img');
      image.className = 'inventory-cover';
      image.src = coverUrl;
      image.alt = '';
      image.loading = 'lazy';
      image.addEventListener('error', () => image.remove(), { once: true });
      row.append(image);
    } else {
      const coverFallback = document.createElement('span');
      coverFallback.className = 'inventory-cover-fallback';
      coverFallback.setAttribute('aria-hidden', 'true');
      coverFallback.textContent = '✿';
      row.append(coverFallback);
    }

    const details = document.createElement('div');
    details.className = 'inventory-details';
    const name = document.createElement('h3');
    name.textContent = title;
    const meta = document.createElement('p');
    meta.textContent = author;
    const price = document.createElement('span');
    price.className = 'inventory-price';
    price.textContent = formatPrice(book.price);
    const conditionLabel = document.createElement('p');
    conditionLabel.className = 'inventory-condition';
    conditionLabel.textContent = `Condition: ${condition}`;
    details.append(name, meta, price, conditionLabel);

    const status = document.createElement('span');
    status.className = sold ? 'sold-label is-sold' : 'sold-label';
    status.textContent = sold ? 'Sold' : 'Available';

    const actions = document.createElement('div');
    actions.className = 'inventory-actions';
    const edit = document.createElement('button');
    edit.className = 'small-button';
    edit.type = 'button';
    edit.textContent = 'Edit';
    edit.addEventListener('click', () => beginEdit(book));

    const toggleSold = document.createElement('button');
    toggleSold.className = 'small-button';
    toggleSold.type = 'button';
    toggleSold.textContent = sold ? 'Mark available' : 'Mark sold';
    toggleSold.addEventListener('click', () => updateSoldStatus(book, !sold));

    const remove = document.createElement('button');
    remove.className = 'small-button danger-button';
    remove.type = 'button';
    remove.textContent = 'Delete';
    remove.addEventListener('click', () => deleteBook(book));

    actions.append(edit, toggleSold, remove);
    row.append(details, status, actions);
    return row;
  }

  function beginEdit(book: BookRow) {
    if (!bookId || !bookTitle || !bookAuthor || !bookDescription || !bookPrice || !bookCondition || !currentCover || !bookSold || !saveButton || !cancelEditButton) return;

    if (bookCover) bookCover.value = '';
    showSelectedCover();
    bookId.value = String(book.id);
    bookTitle.value = getString(book, ['title', 'name']) ?? '';
    bookAuthor.value = getString(book, ['author', 'authors']) ?? '';
    bookDescription.value = getString(book, ['description']) ?? '';
    if (optionalDetails) optionalDetails.open = Boolean(bookDescription.value);
    bookPrice.value = book.price == null ? '' : String(book.price).replace(/[^\d.]/g, '');

    const condition = getString(book, ['condition']) ?? '';
    if (condition && !Array.from(bookCondition.options).some((option) => option.value === condition)) {
      const option = document.createElement('option');
      option.value = condition;
      option.textContent = condition;
      bookCondition.append(option);
    }
    bookCondition.value = condition;
    syncQuickOptions();

    const coverUrl = getImageUrl(book);
    currentCover.textContent = coverUrl ? 'A cover is currently saved. Choose a new image to replace it.' : 'No cover image saved.';
    currentCover.hidden = false;
    bookSold.checked = book.sold === true;
    saveButton.innerHTML = 'Save changes <span aria-hidden="true">→</span>';
    cancelEditButton.hidden = false;
    if (saveAnotherButton) saveAnotherButton.hidden = true;
    selectAdminTab("add-books-tab");
    bookTitle.focus();
  }

  const quickPrices = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-quick-price]'));
  const quickConditions = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-quick-condition]'));

  function syncQuickOptions() {
    for (const button of quickPrices) {
      if (button.dataset.quickPrice === 'other') continue;
      button.setAttribute('aria-pressed', String(Boolean(bookPrice?.value) && Number(bookPrice?.value) === Number(button.dataset.quickPrice)));
    }
    for (const button of quickConditions) {
      button.setAttribute('aria-pressed', String(bookCondition?.value === button.dataset.quickCondition));
    }
  }

  for (const button of quickPrices) {
    button.addEventListener('click', () => {
      if (!bookPrice) return;
      if (button.dataset.quickPrice === 'other') {
        bookPrice.focus();
        return;
      }
      bookPrice.value = Number(button.dataset.quickPrice).toFixed(2);
      syncQuickOptions();
    });
  }
  for (const button of quickConditions) {
    button.addEventListener('click', () => {
      if (!bookCondition) return;
      bookCondition.value = button.dataset.quickCondition ?? '';
      syncQuickOptions();
    });
  }
  bookPrice?.addEventListener('input', syncQuickOptions);
  bookCondition?.addEventListener('change', syncQuickOptions);

  function resetBookForm() {
    if (!bookForm || !bookId || !saveButton || !cancelEditButton || !currentCover) return;
    bookForm.reset();
    syncQuickOptions();
    showSelectedCover();
    if (optionalDetails) optionalDetails.open = false;
    bookId.value = '';
    currentCover.textContent = '';
    currentCover.hidden = true;
    saveButton.innerHTML = 'Add book <span aria-hidden="true">→</span>';
    cancelEditButton.hidden = true;
    if (saveAnotherButton) saveAnotherButton.hidden = false;
  }

  async function updateSoldStatus(book: BookRow, isSold: boolean) {
    if (!supabase) return;
    clearNotice(dashboardNotice);

    const { error } = await supabase.from('books').update({ sold: isSold }).eq('id', book.id);
    if (error) {
      console.error('Unable to update book sold status:', error);
      setNotice(dashboardNotice, 'Could not update this book. Please try again.', 'error');
      return;
    }

    setNotice(dashboardNotice, isSold ? 'Book marked as sold.' : 'Book marked as available.', 'success');
    await loadBooks();
  }

  async function deleteBook(book: BookRow) {
    if (!supabase || !window.confirm(`Delete “${getString(book, ['title', 'name']) ?? 'this book'}”? This cannot be undone.`)) return;
    clearNotice(dashboardNotice);

    const { error } = await supabase.from('books').delete().eq('id', book.id);
    if (error) {
      console.error('Unable to delete book:', error);
      setNotice(dashboardNotice, 'Could not delete this book. Please try again.', 'error');
      return;
    }

    const imagePath = getBucketPath(getImageUrl(book));
    if (imagePath) {
      const { error: imageError } = await supabase.storage.from('books-images').remove([imagePath]);
      if (imageError) {
        console.error('Book was deleted, but its cover image could not be removed:', imageError);
        setNotice(dashboardNotice, 'Book deleted. Its old cover could not be removed from storage.', 'error');
      } else {
        setNotice(dashboardNotice, 'Book deleted.', 'success');
      }
    } else {
      setNotice(dashboardNotice, 'Book deleted.', 'success');
    }

    await loadBooks();
  }

  // Resize in the browser; only the resulting image is sent to storage.
  async function optimiseCover(file: File): Promise<File> {
    const allowed = ['image/jpeg', 'image/png', 'image/webp', 'image/avif', 'image/heic', 'image/heif'];
    if ((!allowed.includes(file.type) && !/\.(jpe?g|png|webp|avif|heic|heif)$/i.test(file.name)) || file.size > 30 * 1024 * 1024) {
      throw new Error('Choose a supported photo under 30 MB.');
    }
    const url = URL.createObjectURL(file);
    try {
      const image = new Image();
      image.src = url;
      try { await image.decode(); } catch {
        throw new Error('This photo could not be opened. Try a JPEG photo or choose a different image.');
      }
      const scale = Math.min(1, 1400 / Math.max(image.naturalWidth, image.naturalHeight));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
      canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Photo processing is unavailable in this browser.');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
      let blob: Blob | null = null;
      for (const quality of [0.85, 0.72, 0.58]) {
        blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', quality));
        if (blob && blob.size <= 1024 * 1024) break;
      }
      if (!blob || blob.type !== 'image/jpeg' || blob.size > 5 * 1024 * 1024) throw new Error('Photo compression failed. Choose a smaller photo.');
      if (['image/jpeg', 'image/png', 'image/webp', 'image/avif'].includes(file.type) && file.size <= blob.size && scale === 1) return file;
      return new File([blob], 'book-cover.jpg', { type: 'image/jpeg' });
    } finally { URL.revokeObjectURL(url); }
  }

  async function saveBook(event: SubmitEvent) {
    event.preventDefault();
    if (!supabase || !bookForm || !bookId || !bookTitle || !bookAuthor || !bookDescription || !bookPrice || !bookCondition || !bookCover || !bookSold) return;
    clearNotice(dashboardNotice);

    if (savingBook) return;
    const originalFile = bookCover.files?.[0];
    const addAnother = event.submitter === saveAnotherButton && !bookId.value;
    let file: File | undefined;

    const parsedPrice = Number(bookPrice.value);
    if (!Number.isFinite(parsedPrice) || parsedPrice < 0) {
      setNotice(dashboardNotice, 'Enter a valid non-negative price.', 'error');
      return;
    }

    const editingId = bookId.value;
    const existing = editingId
      ? Array.from(inventoryList?.querySelectorAll<HTMLElement>('[data-book-id]') ?? []).find((item) => item.dataset.bookId === editingId)
      : undefined;
    const previousCover = existing?.dataset.coverUrl ?? '';
    let uploadedPath: string | undefined;
    let coverUrl = previousCover;

    savingBook = true;
    const controls = Array.from(bookForm.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | HTMLButtonElement>('input, select, textarea, button'));
    const previouslyDisabled = controls.map(control => control.disabled);
    controls.forEach(control => { control.disabled = true; });
    try {
      if (originalFile) {
        setNotice(dashboardNotice, 'Preparing your cover photo…', 'success');
        try { file = await optimiseCover(originalFile); } catch (error) {
          setNotice(dashboardNotice, error instanceof Error ? error.message : 'Could not prepare the photo.', 'error');
          return;
        }
      }
      if (file) {
        const extension = file.name.split('.').pop()?.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 8) || 'img';
        uploadedPath = `book-covers/${crypto.randomUUID()}.${extension}`;
        const { data, error } = await supabase.storage.from('books-images').upload(uploadedPath, file, {
          cacheControl: '3600',
          contentType: file.type,
          upsert: false,
        });
        if (error) throw error;
        coverUrl = supabase.storage.from('books-images').getPublicUrl(data.path).data.publicUrl;
      }

      const record = {
        title: bookTitle.value.trim(),
        author: bookAuthor.value.trim(),
        description: bookDescription.value.trim() || null,
        price: parsedPrice,
        condition: bookCondition.value,
        image_url: coverUrl || null,
        sold: bookSold.checked,
      };

      const result = editingId
        ? await supabase.from('books').update(record).eq('id', editingId)
        : await supabase.from('books').insert(record);
      if (result.error) throw result.error;

      const previousImagePath = getBucketPath(previousCover);
      if (file && previousImagePath && previousImagePath !== uploadedPath) {
        const { error } = await supabase.storage.from('books-images').remove([previousImagePath]);
        if (error) console.error('Book was saved, but its previous cover could not be removed:', error);
      }

      resetBookForm();
      setNotice(dashboardNotice, editingId ? 'Book updated.' : addAnother ? 'Book added. Ready for the next one!' : 'Book added.', 'success');
      if (!addAnother) selectAdminTab('manage-books-tab');
      await loadBooks();
    } catch (error) {
      console.error('Unable to save book:', error);
      if (uploadedPath) {
        const { error: cleanupError } = await supabase.storage.from('books-images').remove([uploadedPath]);
        if (cleanupError) console.error('The uploaded image could not be cleaned up:', cleanupError);
      }
      setNotice(dashboardNotice, 'Could not save this book. Check the database setup and try again.', 'error');
    } finally {
      controls.forEach((control, index) => { control.disabled = previouslyDisabled[index]; });
      savingBook = false;
    }
  }

  async function initialize() {
    try {
      supabase = getSupabaseClient();
    } catch (error) {
      console.error('Supabase configuration is missing:', error);
      setNotice(authNotice, 'Supabase is not configured. Set the project URL and publishable key before using admin.', 'error');
      const submit = loginForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      return;
    }

    const { data, error } = await supabase.auth.getSession();
    if (error) {
      console.error('Unable to read the current admin session:', error);
      setNotice(authNotice, 'Could not check the current session. Please refresh and try again.', 'error');
      return;
    }

    if (data.session) {
      await authorizeCurrentUser();
    }
  }

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase || !loginEmail || !loginPassword) return;
    clearNotice(authNotice);

    if (!loginEmail.value.trim()) {
      setNotice(authNotice, 'Enter your administrator email address.', 'error');
      loginEmail.focus();
      return;
    }
    if (!loginEmail.checkValidity()) {
      setNotice(authNotice, 'Enter a valid email address.', 'error');
      loginEmail.focus();
      return;
    }
    if (!loginPassword.value) {
      setNotice(authNotice, 'Enter your administrator password.', 'error');
      loginPassword.focus();
      return;
    }

    const submit = loginForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    setNotice(authNotice, 'Signing in...');

    try {
      const { error } = await supabase.auth.signInWithPassword({
        email: loginEmail.value.trim(),
        password: loginPassword.value,
      });
      if (error) throw error;
      await authorizeCurrentUser();
    } catch (error) {
      console.error('Admin sign-in failed:', error);
      setNotice(authNotice, getAuthErrorMessage(error), 'error');
    } finally {
      if (submit) submit.disabled = false;
    }
  });

  bookForm?.addEventListener('submit', saveBook);
  cancelEditButton?.addEventListener('click', () => {
    resetBookForm();
    clearNotice(dashboardNotice);
  });
  refreshButton?.addEventListener('click', loadBooks);

  signOutButton?.addEventListener('click', async () => {
    if (!supabase) return;
    const { error } = await supabase.auth.signOut();
    if (error) {
      console.error('Unable to sign out admin:', error);
      setNotice(dashboardNotice, 'Could not sign out. Please try again.', 'error');
      return;
    }

    resetBookForm();
    selectAdminTab("add-books-tab");
    await showLogin();
  });

  void initialize();
</script>

