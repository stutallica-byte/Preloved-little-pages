  .hero-caption span { width: 22px; height: 1px; background: #c1a477; }

  .search-bar { position: absolute; z-index: 2; bottom: 16px; left: 0; width: min(590px, 57%); height: 59px; display: flex; align-items: center; padding: 6px; border: 1px solid #e8e4da; border-radius: 5px; background: var(--paper); box-shadow: 0 13px 35px #263d320d; }
  .search-icon { width: 43px; display: grid; place-items: center; color: #798579; }
  .search-icon svg { width: 18px; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
  .search-bar input { min-width: 0; flex: 1; border: 0; outline: 0; color: var(--ink); background: transparent; font-size: 11px; }
  .search-bar input::placeholder { color: #a1a39a; }
  .search-bar button { height: 43px; padding: 0 15px; border: 0; border-radius: 3px; color: #fffdf8; background: var(--green); cursor: pointer; font-size: 10px; font-weight: 700; }
  .search-bar button span { margin-left: 8px; font-size: 15px; font-weight: 400; }

  .trust-strip { min-height: 65px; display: flex; align-items: center; justify-content: center; gap: clamp(20px, 5vw, 68px); border-block: 1px solid #ebe8de; color: #687368; background: #f4f2e9; font-size: 10px; }
  .trust-strip div { display: flex; align-items: center; gap: 9px; }
